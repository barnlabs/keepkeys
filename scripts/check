#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

node scripts/validate-plugin.mjs
node scripts/validate-adapters.mjs
node --check plugins/keepkeys/mcp/server.mjs
node --check plugins/keepkeys/mcp/server.test.mjs
node --check plugins/keepkeys/scripts/keepkeys-cli.mjs
node --check plugins/keepkeys/scripts/platform.mjs
node --check scripts/scan-secrets.mjs
python3 -m py_compile \
  __init__.py \
  adapters/hermes/plugin.py \
  adapters/hermes/test_plugin.py \
  plugins/keepkeys/scripts/keepkeys.linux.py \
  plugins/keepkeys/scripts/test_keepkeys_linux.py
sh -n plugins/keepkeys/scripts/keepkeys
sh -n scripts/bootstrap
sh -n scripts/check
sh -n scripts/test
sh -n scripts/doctor
sh -n scripts/package-submission
sh -n scripts/package-release

if command -v grok >/dev/null 2>&1; then
  grok plugin validate plugins/keepkeys >/dev/null
fi

if [ "$(uname -s)" = "Darwin" ]; then
  check_root=$(/usr/bin/mktemp -d)
  trap '/bin/rm -rf "$check_root"' EXIT INT TERM
  KEEPKEYS_CACHE_DIR="$check_root/cache" \
    plugins/keepkeys/scripts/keepkeys --build-only >/dev/null
fi

node scripts/scan-secrets.mjs

printf '%s\n' "KeepKeys checks passed."
