#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

node --test plugins/keep-keys/mcp/server.test.mjs

test_root=$(/usr/bin/mktemp -d)
trap '/bin/rm -rf "$test_root"' EXIT INT TERM
KEEPKEYS_CACHE_DIR="$test_root/cache" \
  plugins/keep-keys/scripts/keepkeys --self-test
KEEPKEYS_CACHE_DIR="$test_root/cache" \
  plugins/keep-keys/scripts/keepkeys status

printf '%s\n' "KeepKeys headless tests passed."
