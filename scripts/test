#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

node --test plugins/keepkeys/mcp/server.test.mjs
python3 -m unittest adapters.hermes.test_plugin
python3 -m unittest plugins.keepkeys.scripts.test_keepkeys_linux

case "$(uname -s)" in
  Darwin)
    test_root=$(/usr/bin/mktemp -d)
    trap '/bin/rm -rf "$test_root"' EXIT INT TERM
    KEEPKEYS_CACHE_DIR="$test_root/cache" \
      plugins/keepkeys/scripts/keepkeys --self-test
    KEEPKEYS_CACHE_DIR="$test_root/cache" \
      plugins/keepkeys/scripts/keepkeys status
    ;;
  Linux)
    python3 plugins/keepkeys/scripts/keepkeys.linux.py --self-test
    ;;
  *)
    printf '%s\n' "Use scripts/test.ps1 on Windows." >&2
    exit 1
    ;;
esac

printf '%s\n' "KeepKeys headless tests passed on $(uname -s)."
