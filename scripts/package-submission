#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
plugin="$root/plugins/keepkeys"
dist="$root/dist"
build_root=$(/usr/bin/mktemp -d)
trap '/bin/rm -rf "$build_root"' EXIT INT TERM

mkdir -p "$build_root/keepkeys/.codex-plugin"
cp "$plugin/.codex-plugin/plugin.json" "$build_root/keepkeys/.codex-plugin/plugin.json"
cp -R "$plugin/assets" "$build_root/keepkeys/assets"
cp -R "$plugin/skills" "$build_root/keepkeys/skills"
cp -R "$plugin/scripts" "$build_root/keepkeys/scripts"
/bin/rm -f "$build_root/keepkeys/scripts/"*.test.mjs
/usr/bin/find "$build_root/keepkeys/scripts" -type d -name '__pycache__' -prune \
  -exec /bin/rm -rf {} +
/usr/bin/find "$build_root/keepkeys/scripts" -type f -name '*.pyc' -delete
cp "$root/LICENSE" "$build_root/keepkeys/LICENSE"
cp "$root/TERMS.md" "$build_root/keepkeys/TERMS.md"
cp "$root/docs/privacy-and-data-handling.md" "$build_root/keepkeys/PRIVACY.md"

node - "$build_root/keepkeys" <<'NODE'
const assert = require("node:assert/strict");
const fs = require("node:fs");
const path = require("node:path");
const root = process.argv[2];
const manifestPath = path.join(root, ".codex-plugin", "plugin.json");
const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
delete manifest.mcpServers;
fs.writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`, { mode: 0o600 });

assert.equal(manifest.name, "keepkeys");
assert.match(manifest.version, /^\d+\.\d+\.\d+$/);
assert.equal(manifest.skills, "./skills/");
assert.equal(manifest.mcpServers, undefined);
assert.equal(manifest.author.name, "BarnLabs");
assert.equal(manifest.license, "Apache-2.0");
for (const relative of [
  "assets/icon.png",
  "assets/logo.png",
  "assets/logo-dark.png",
  "skills/keepkeys/SKILL.md",
  "scripts/keepkeys",
  "scripts/keepkeys.swift",
  "scripts/keepkeys-cli.mjs",
  "scripts/keepkeys-portal.mjs",
  "scripts/keepkeys-store.mjs",
  "scripts/keepkeys.linux.py",
  "scripts/keepkeys.windows.ps1",
  "scripts/check-for-update.mjs",
  "scripts/platform.mjs",
  "LICENSE",
  "PRIVACY.md",
  "TERMS.md",
]) {
  assert.ok(fs.existsSync(path.join(root, relative)), `${relative} is missing`);
}
NODE

if find "$build_root/keepkeys" \( -name '.mcp.json' -o -path '*/mcp/*' \) -print | grep .
then
  printf '%s\n' "Skills-only submission unexpectedly contains MCP files." >&2
  exit 1
fi

mkdir -p "$dist"
version=$(node -e 'const fs=require("node:fs");const p=process.argv[1];process.stdout.write(JSON.parse(fs.readFileSync(p,"utf8")).version)' "$plugin/.codex-plugin/plugin.json")
archive="$dist/keepkeys-skills-$version.zip"
checksum="$archive.sha256"
rm -f "$archive" "$checksum"
(
  export LC_ALL=C
  export TZ=UTC
  /usr/bin/find "$build_root/keepkeys" -exec /usr/bin/touch -t 198001010000 {} +
  cd "$build_root"
  /usr/bin/find keepkeys -print |
    /usr/bin/sort |
    /usr/bin/zip -X -q "$archive" -@
)

for member in \
  "keepkeys/.codex-plugin/plugin.json" \
  "keepkeys/skills/keepkeys/SKILL.md" \
  "keepkeys/scripts/keepkeys" \
  "keepkeys/scripts/keepkeys.swift" \
  "keepkeys/scripts/keepkeys-cli.mjs" \
  "keepkeys/scripts/keepkeys-portal.mjs" \
  "keepkeys/scripts/keepkeys-store.mjs" \
  "keepkeys/scripts/keepkeys.linux.py" \
  "keepkeys/scripts/keepkeys.windows.ps1" \
  "keepkeys/scripts/check-for-update.mjs" \
  "keepkeys/scripts/platform.mjs" \
  "keepkeys/LICENSE" \
  "keepkeys/PRIVACY.md" \
  "keepkeys/TERMS.md"
do
  if ! /usr/bin/unzip -Z1 "$archive" | /usr/bin/grep -Fqx "$member"; then
    printf '%s\n' "Submission archive is missing $member." >&2
    exit 1
  fi
done

if /usr/bin/unzip -Z1 "$archive" | /usr/bin/grep -E '(^|/)(\.mcp\.json|mcp/)'; then
  printf '%s\n' "Submission archive unexpectedly contains MCP files." >&2
  exit 1
fi
if /usr/bin/unzip -Z1 "$archive" | /usr/bin/grep -E '(^|/)(__pycache__/|[^/]+\.pyc$)'; then
  printf '%s\n' "Submission archive unexpectedly contains Python bytecode." >&2
  exit 1
fi

unpacked="$build_root/unpacked"
mkdir -p "$unpacked"
/usr/bin/unzip -q "$archive" -d "$unpacked"
if [ ! -x "$unpacked/keepkeys/scripts/keepkeys" ]; then
  printf '%s\n' "Submission archive did not preserve the launcher executable bit." >&2
  exit 1
fi

KEEPKEYS_CACHE_DIR="$build_root/cache" \
  "$unpacked/keepkeys/scripts/keepkeys" --build-only >/dev/null
KEEPKEYS_CACHE_DIR="$build_root/cache" \
  "$unpacked/keepkeys/scripts/keepkeys" --self-test >/dev/null

(
  cd "$dist"
  /usr/bin/shasum -a 256 "$(/usr/bin/basename "$archive")" \
    > "$(/usr/bin/basename "$checksum")"
  /usr/bin/shasum -a 256 -c "$(/usr/bin/basename "$checksum")" >/dev/null
)

printf '%s\n' "$archive"
printf '%s\n' "$checksum"
