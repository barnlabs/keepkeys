#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
ci_home=$(mktemp -d)
ci_runtime=$(mktemp -d)
cleanup() {
  rm -rf "$ci_home" "$ci_runtime"
}
trap cleanup EXIT INT TERM
chmod 700 "$ci_home" "$ci_runtime"

export HOME="$ci_home"
export XDG_RUNTIME_DIR="$ci_runtime"
export KEEPKEYS_LINUX_HELPER="$root/plugins/keepkeys/scripts/keepkeys.linux.py"
export KEEPKEYS_PLUGIN_ROOT="$root"

dbus-run-session -- sh -eu <<'INNER'
daemon_environment=$(
  printf '%s' 'keepkeys-ci-keyring' |
    gnome-keyring-daemon --unlock --components=secrets
)
eval "$daemon_environment"
export GNOME_KEYRING_CONTROL
python3 "$KEEPKEYS_LINUX_HELPER" doctor
KEEPKEYS_PORTAL_NATIVE_TEST=1 \
  node "$KEEPKEYS_PLUGIN_ROOT/plugins/keepkeys/scripts/keepkeys-portal.mjs" \
  --native-portal-self-test
INNER
