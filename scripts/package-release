#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
dist="$root/dist"
build_root=$(/usr/bin/mktemp -d)
trap '/bin/rm -rf "$build_root"' EXIT INT TERM

version=$(
  node -e 'const fs=require("node:fs");const p=process.argv[1];process.stdout.write(JSON.parse(fs.readFileSync(p,"utf8")).version)' \
    "$root/plugins/keepkeys/.codex-plugin/plugin.json"
)
package_root="$build_root/keepkeys"
archive="$dist/keepkeys-$version-source.zip"
checksum="$archive.sha256"

/bin/mkdir -p "$package_root" "$dist"
/usr/bin/rsync -a \
  --exclude '.git' \
  --exclude 'dist' \
  --exclude '__pycache__' \
  --exclude '*.pyc' \
  "$root/" "$package_root/"

/bin/rm -f "$archive" "$checksum"
(
  cd "$build_root"
  /usr/bin/zip -X -q -r "$archive" keepkeys
)

for member in \
  "keepkeys/.agents/plugins/marketplace.json" \
  "keepkeys/.grok-plugin/marketplace.json" \
  "keepkeys/.claude-plugin/marketplace.json" \
  "keepkeys/.omp-plugin/marketplace.json" \
  "keepkeys/gemini-extension.json" \
  "keepkeys/plugin.yaml" \
  "keepkeys/plugins/keepkeys/.grok-plugin/plugin.json" \
  "keepkeys/plugins/keepkeys/.mcp.grok.json" \
  "keepkeys/plugins/keepkeys/mcp/server.mjs" \
  "keepkeys/plugins/keepkeys/scripts/keepkeys" \
  "keepkeys/plugins/keepkeys/scripts/keepkeys.linux.py" \
  "keepkeys/plugins/keepkeys/scripts/keepkeys.windows.ps1" \
  "keepkeys/plugins/keepkeys/scripts/platform.mjs"
do
  if ! /usr/bin/unzip -Z1 "$archive" | /usr/bin/grep -Fqx "$member"; then
    printf '%s\n' "Release archive is missing $member." >&2
    exit 1
  fi
done

(
  cd "$dist"
  /usr/bin/shasum -a 256 "$(/usr/bin/basename "$archive")" \
    > "$(/usr/bin/basename "$checksum")"
  /usr/bin/shasum -a 256 -c "$(/usr/bin/basename "$checksum")" >/dev/null
)

printf '%s\n' "$archive"
printf '%s\n' "$checksum"
